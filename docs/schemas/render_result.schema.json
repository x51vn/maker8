{
  "$defs": {
    "AssetWarning": {
      "description": "Describes one asset/scene-level issue that was tolerated during rendering.\n\nCollected in ``PipelineContext.warnings`` and surfaced in ``RenderResult``.",
      "properties": {
        "asset_id": {
          "default": "",
          "title": "Asset Id",
          "type": "string"
        },
        "scene_id": {
          "default": "",
          "title": "Scene Id",
          "type": "string"
        },
        "stage": {
          "default": "",
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "fallback_used": {
          "default": "",
          "title": "Fallback Used",
          "type": "string"
        }
      },
      "title": "AssetWarning",
      "type": "object"
    },
    "DropboxFileRef": {
      "description": "Reference to a file stored in Dropbox.",
      "properties": {
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "file_id": {
          "default": "",
          "title": "File Id",
          "type": "string"
        },
        "rev": {
          "default": "",
          "title": "Rev",
          "type": "string"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "mime": {
          "default": "",
          "title": "Mime",
          "type": "string"
        }
      },
      "title": "DropboxFileRef",
      "type": "object"
    },
    "DropboxOutput": {
      "description": "References to the files uploaded to Dropbox.",
      "properties": {
        "video": {
          "$ref": "#/$defs/DropboxFileRef"
        },
        "manifest": {
          "$ref": "#/$defs/DropboxFileRef"
        }
      },
      "title": "DropboxOutput",
      "type": "object"
    },
    "EngineVersions": {
      "description": "Versions of the core tools used during rendering.",
      "properties": {
        "moviepy": {
          "default": "",
          "title": "Moviepy",
          "type": "string"
        },
        "ffmpeg": {
          "default": "",
          "title": "Ffmpeg",
          "type": "string"
        },
        "youtube_dlp": {
          "default": "",
          "title": "Youtube Dlp",
          "type": "string"
        }
      },
      "title": "EngineVersions",
      "type": "object"
    },
    "ErrorInfo": {
      "description": "Serialisable error data included in Kafka result / DLQ messages.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "DONE",
        "FAILED",
        "PARTIAL"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "OutputMeta": {
      "description": "Basic metadata about the rendered video.",
      "properties": {
        "duration": {
          "default": 0,
          "title": "Duration",
          "type": "number"
        },
        "w": {
          "default": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "default": 0,
          "title": "H",
          "type": "integer"
        },
        "fps": {
          "default": 0,
          "title": "Fps",
          "type": "number"
        },
        "size_bytes": {
          "default": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "title": "OutputMeta",
      "type": "object"
    },
    "PublishTarget": {
      "properties": {
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "variant": {
          "default": "",
          "title": "Variant",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "platform",
        "account_ref"
      ],
      "title": "PublishTarget",
      "type": "object"
    },
    "SourceAttribution": {
      "description": "Attribution for a single source asset used in the video.",
      "properties": {
        "asset_ref": {
          "default": "",
          "title": "Asset Ref",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        },
        "creator": {
          "default": "",
          "title": "Creator",
          "type": "string"
        },
        "license": {
          "default": "",
          "title": "License",
          "type": "string"
        },
        "credit_text": {
          "default": "",
          "title": "Credit Text",
          "type": "string"
        }
      },
      "title": "SourceAttribution",
      "type": "object"
    },
    "Trace": {
      "properties": {
        "correlation_id": {
          "default": "",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "title": "Trace",
      "type": "object"
    },
    "UploaderMetadata": {
      "description": "Normalized common metadata for downstream uploaders.\n\nThis is the canonical layer shared across all platforms.\nPer-platform overrides live in ``PublishTarget.metadata``.",
      "properties": {
        "channel_id": {
          "default": "",
          "title": "Channel Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "short_title": {
          "default": "",
          "title": "Short Title",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "lang": {
          "default": "",
          "title": "Lang",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "hashtags": {
          "items": {
            "type": "string"
          },
          "title": "Hashtags",
          "type": "array"
        },
        "category": {
          "default": "",
          "title": "Category",
          "type": "string"
        },
        "visibility": {
          "default": "private",
          "title": "Visibility",
          "type": "string"
        },
        "scheduled_publish_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Publish At"
        },
        "content_rating": {
          "default": "general",
          "title": "Content Rating",
          "type": "string"
        },
        "thumbnail_ref": {
          "default": "",
          "title": "Thumbnail Ref",
          "type": "string"
        },
        "thumbnail_source_url": {
          "default": "",
          "title": "Thumbnail Source Url",
          "type": "string"
        },
        "thumbnail_strategy": {
          "default": "source_asset",
          "title": "Thumbnail Strategy",
          "type": "string"
        },
        "source_attributions": {
          "items": {
            "$ref": "#/$defs/SourceAttribution"
          },
          "title": "Source Attributions",
          "type": "array"
        },
        "credits": {
          "items": {
            "type": "string"
          },
          "title": "Credits",
          "type": "array"
        },
        "canonical_url": {
          "default": "",
          "title": "Canonical Url",
          "type": "string"
        },
        "cta_url": {
          "default": "",
          "title": "Cta Url",
          "type": "string"
        }
      },
      "title": "UploaderMetadata",
      "type": "object"
    }
  },
  "description": "``video.render.result.v1`` payload.",
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "job_key": {
      "default": "",
      "title": "Job Key",
      "type": "string"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "canvas_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canvas Profile"
    },
    "dropbox": {
      "$ref": "#/$defs/DropboxOutput"
    },
    "output_meta": {
      "$ref": "#/$defs/OutputMeta"
    },
    "uploader_metadata": {
      "$ref": "#/$defs/UploaderMetadata"
    },
    "publish_targets": {
      "items": {
        "$ref": "#/$defs/PublishTarget"
      },
      "title": "Publish Targets",
      "type": "array"
    },
    "asset_report": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Asset Report",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/AssetWarning"
      },
      "title": "Warnings",
      "type": "array"
    },
    "engine_versions": {
      "$ref": "#/$defs/EngineVersions"
    },
    "trace": {
      "$ref": "#/$defs/Trace"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "status"
  ],
  "title": "RenderResult",
  "type": "object"
}
