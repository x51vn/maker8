# ──────────────────────────────────────────────────────────────────────────────
# Maker8 Render Worker – Environment Variables (TEMPLATE)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real secrets. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ── Centralized credential source (recommended) ──────────────────────────────
# DB mode: all runtime secrets are read from editor8 service_keys via PostgreSQL.
MAKER8_CREDENTIAL_SOURCE=db
MAKER8_EDITOR8_DATABASE_URL=
MAKER8_CREDENTIAL_CACHE_TTL_SEC=60

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Bootstrap servers (example from KAFKA_INTEGRATION.md: 10.113.213.9:9094)
MAKER8_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MAKER8_KAFKA_GROUP_ID=maker8-render
MAKER8_KAFKA_RENDER_REQUEST_TOPIC=video.render.request.v1
MAKER8_KAFKA_RENDER_RESULT_TOPIC=video.render.result.v1
MAKER8_KAFKA_RENDER_DLQ_TOPIC=video.render.dlq.v1

# ── Kafka SASL (from KAFKA_INTEGRATION.md, if needed) ────────────────────────
# Uncomment and fill if Kafka requires SASL authentication
# MAKER8_KAFKA_USERNAME=client
# MAKER8_KAFKA_PASSWORD=client-secret
# MAKER8_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# MAKER8_KAFKA_SASL_MECHANISM=PLAIN

# ── Dropbox (legacy env_file fallback only) ──────────────────────────────────
MAKER8_DROPBOX_APP_KEY=
MAKER8_DROPBOX_APP_SECRET=
MAKER8_DROPBOX_REFRESH_TOKEN=

# ── TTS ───────────────────────────────────────────────────────────────────────
MAKER8_TTS_PROVIDER=gtts
MAKER8_TTS_PRESETS_PATH=config/tts_presets.json

# ── Google Cloud TTS ──────────────────────────────────────────────────────────
MAKER8_GOOGLE_CLOUD_TTS_ENABLED=false
MAKER8_GOOGLE_APPLICATION_CREDENTIALS=
# Directory with service-account JSON files for round-robin rotation.
# Place *.json files in this folder; the worker rotates per video.
MAKER8_GOOGLE_TTS_KEYS_DIR=gg-tts-keys

# ── ElevenLabs TTS (legacy env_file fallback only) ───────────────────────────
MAKER8_ELEVENLABS_API_KEY=
# Directory with API key files (.txt/.key) for round-robin rotation.
MAKER8_ELEVENLABS_KEYS_DIR=elevenlabs-keys

# ── Work directory ────────────────────────────────────────────────────────────
MAKER8_WORK_DIR=/tmp/maker8

# ── Retry ─────────────────────────────────────────────────────────────────────
MAKER8_RENDER_MAX_ATTEMPTS=5
MAKER8_RENDER_RETRY_MIN_DELAY_SEC=60.0
MAKER8_RENDER_RETRY_MAX_DELAY_SEC=21600.0

# ── Logging ───────────────────────────────────────────────────────────────────
MAKER8_LOG_LEVEL=INFO
MAKER8_LOG_FORMAT=json

# ── yt-dlp ────────────────────────────────────────────────────────────────────
# Executable path (empty = auto-detect from managed dir or PATH)
# MAKER8_YTDLP_PATH=
# Managed binary directory
MAKER8_YTDLP_BIN_DIR=/opt/maker8/bin/yt-dlp
# Auth: cookies file or browser extraction (pick one)
# MAKER8_YTDLP_COOKIES_FILE=/path/to/cookies.txt
# MAKER8_YTDLP_COOKIES_FROM_BROWSER=chrome
# User-Agent string for requests
# MAKER8_YTDLP_USER_AGENT=
# Extractor args (e.g., youtube:player_client=default,mweb)
# MAKER8_YTDLP_EXTRACTOR_ARGS=
MAKER8_YTDLP_VERBOSE_ON_FAILURE=true
MAKER8_YTDLP_RESOLVE_TIMEOUT_SEC=120
MAKER8_YTDLP_DOWNLOAD_TIMEOUT_SEC=600

# ── yt-dlp auto-update ───────────────────────────────────────────────────────
MAKER8_YTDLP_AUTO_UPDATE_ENABLED=false
MAKER8_YTDLP_CHANNEL=stable
MAKER8_YTDLP_UPDATE_INTERVAL_SEC=21600
MAKER8_YTDLP_DOWNLOAD_TIMEOUT=120
MAKER8_YTDLP_VERIFY_CHECKSUM=true
MAKER8_YTDLP_MIN_CHECK_INTERVAL_SEC=300
