# ──────────────────────────────────────────────────────────────────────────────
# Maker8 Deployment Config (TEMPLATE)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.deploy` and fill in real values.
# `.env.deploy` is gitignored — never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# SSH deployment target
DEPLOYMENT_HOST=<deployment-host-ip>
DEPLOYMENT_USER=<ssh-user>
SSH_KEY=<path-to-ssh-key>
COMPOSE_DIR=<remote-compose-dir>

# Container registry
REGISTRY=<docker-registry>/<org>

# Image tags (set to the versions you want to deploy)
MAKER8_TAG=<maker8-image-tag>
EDITOR8_BACKEND_TAG=<editor8-backend-image-tag>
EDITOR8_FRONTEND_TAG=<editor8-frontend-image-tag>
